#!/bin/bash

# 查看 GPU 运行进程的用户信息
# 默认保留 nvidia-smi 的进程顺序；可选长命令和排序参数。

LONG_MODE=false
SORT_KEY=""

usage() {
    cat <<'EOF'
Usage: gpu-pid [-l|--long] [-s|--sort KEY]

Sort keys (descending): gmem, ram, ram+, mem, cpu
Without --sort, preserve the process order returned by nvidia-smi.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -l|--long)
            LONG_MODE=true
            shift
            ;;
        -s|--sort)
            if [ -z "${2:-}" ]; then
                echo "Error: $1 requires a sort key" >&2
                usage >&2
                exit 2
            fi
            SORT_KEY=${2,,}
            shift 2
            ;;
        --sort=*)
            SORT_KEY=${1#*=}
            if [ -z "$SORT_KEY" ]; then
                echo "Error: --sort requires a sort key" >&2
                usage >&2
                exit 2
            fi
            SORT_KEY=${SORT_KEY,,}
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$SORT_KEY" in
    "") sort_field="" ;;
    ram+) sort_field=1 ;;
    ram)  sort_field=2 ;;
    gmem) sort_field=6 ;;
    mem)  sort_field=7 ;;
    cpu)  sort_field=8 ;;
    *)
        echo "Error: invalid sort key: $SORT_KEY" >&2
        usage >&2
        exit 2
        ;;
esac

if $LONG_MODE; then
    # 长模式：完整命令
    cmd_len=150
    separator="------------------------------------------------------------------------------------------------------------------------------------------------"
else
    # 默认：紧凑模式
    cmd_len=25
    separator="------------------------------------------------------------------------------------------------"
fi

# 使用 printf 格式化输出
format="%-3s %-7s %-12s %-7s %-7s %-7s %-5s %-5s %-5s %-11s %s\n"

# 打印表头
printf "$format" "GPU" "PID" "USER" "GMEM" "RAM" "RAM+" "MEM%" "CPU%" "STAT" "TIME" "CMD"
echo "$separator"

# 将 KiB 转为便于比较的 IEC 单位。
human_kb() {
    awk -v kb="$1" 'BEGIN {
        if (kb >= 1048576) printf "%.1fG", kb / 1048576
        else if (kb >= 1024) printf "%.1fM", kb / 1024
        else printf "%dK", kb
    }'
}

# 一次性获取 PID、PPID 和 RSS，后续从同一个快照计算每棵进程树。
process_table=$(ps -e -o pid=,ppid=,rss= 2>/dev/null)

tree_rss_kb() {
    awk -v root="$1" '
        { parent[$1]=$2; rss[$1]=$3 }
        END {
            included[root]=1
            total=rss[root]+0
            changed=1
            while (changed) {
                changed=0
                for (pid in parent) {
                    if (!included[pid] && included[parent[pid]]) {
                        included[pid]=1
                        total+=rss[pid]
                        changed=1
                    }
                }
            }
            print total
        }
    ' <<< "$process_table"
}

# 输出内部记录；数值字段置于前部，供可选排序使用。
gpu_records() {
while read -r line; do
    pid=$(echo "$line" | cut -d',' -f1 | tr -d ' ')
    gpu_uuid=$(echo "$line" | cut -d',' -f2 | tr -d ' ')
    gpu_mem=$(echo "$line" | cut -d',' -f3 | tr -d ' ')

    # 根据 UUID 获取 GPU 编号
    gpu_id=$(nvidia-smi --query-gpu=index --id="$gpu_uuid" --format=csv,noheader 2>/dev/null | tr -d ' ')

    if [ -n "$pid" ] && [ "$pid" != "No running" ]; then
        # 获取进程用户
        user=$(ps -o user= -p "$pid" 2>/dev/null)
        # 获取 CPU 和内存占用
        cpu_mem_rss=$(ps -o %cpu=,%mem=,rss= -p "$pid" 2>/dev/null)
        cpu=$(echo "$cpu_mem_rss" | awk '{print $1}')
        mem=$(echo "$cpu_mem_rss" | awk '{print $2}')
        rss_kb=$(echo "$cpu_mem_rss" | awk '{print $3}')
        # 获取进程状态
        stat=$(ps -o stat= -p "$pid" 2>/dev/null | xargs)
        # 获取运行时间
        time=$(ps -o etime= -p "$pid" 2>/dev/null | xargs)
        # 获取启动命令并截断
        cmd=$(ps -o args= -p "$pid" 2>/dev/null | cut -c1-$cmd_len)

        if [ -n "$user" ]; then
            tree_kb=$(tree_rss_kb "$pid")
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
                "$tree_kb" "$rss_kb" "$gpu_id" "$pid" "$user" "$gpu_mem" \
                "$mem" "$cpu" "$stat" "$time" "$cmd"
        fi
    fi
done < <(nvidia-smi --query-compute-apps=pid,gpu_uuid,used_memory --format=csv,noheader,nounits 2>/dev/null)
}

while IFS=$'\t' read -r tree_kb rss_kb gpu_id pid user gpu_mem mem cpu stat time cmd; do
    [ -n "$pid" ] || continue
    printf "$format" "$gpu_id" "$pid" "$user" "${gpu_mem}M" \
        "$(human_kb "$rss_kb")" "$(human_kb "$tree_kb")" \
        "$mem" "$cpu" "$stat" "$time" "$cmd"
done < <(
    if [ -n "$sort_field" ]; then
        gpu_records | sort -s -t $'\t' -k"$sort_field","$sort_field"nr
    else
        gpu_records
    fi
)
